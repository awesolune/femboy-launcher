---
import config from '../config/downloads.json';
import { resolveDownloads } from '../lib/downloads.js';
import { catSvg } from '../lib/cat.js';
import site from '../config/site.json';
import Icon from './Icon.astro';

const d = resolveDownloads(config);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const onHome = Astro.url.pathname.replace(/\/$/, '') === base.replace(/\/$/, '');
const homeLink = (hash: string) => onHome ? hash : `${base}${hash}`;
const year = d.date ? d.date.iso.slice(0, 4) : null;
---

<footer class="site-footer multi-footer">
  <div class="foot-cat" aria-hidden="true" set:html={catSvg('head')} />
  <div class="wrap">
    <div class="foot-brand">
      <p class="brand-name foot-name" translate="no">Femboy<small>launcher</small></p>
      <p>
        Уютный Minecraft-лаунчер для Windows. Независимый проект: это не официальный продукт Minecraft, он не одобрен Mojang Studios
        и Microsoft и не связан с ними.
      </p>
    </div>
    <ul class="foot-links" aria-label="Ссылки">
      <li><a href={homeLink('#download')}>Скачать</a></li>
      <li><a href={homeLink('#features')}>Возможности</a></li>
      <li><a href={homeLink('#gallery')}>Скриншоты</a></li>
      <li><a href={homeLink('#overview')}>Видеообзор</a></li>
      <li><a href={homeLink('#faq')}>Вопросы</a></li>
      <li><a href={homeLink('#help')}>Помощь с запуском</a></li>
      <li><a href={`${base}releases/`}>История версий</a></li>
      {
        d.storage.folderUrl && (
          <li>
            <a href={d.storage.folderUrl} target="_blank" rel="noopener">
              Файлы {d.storage.where}
            </a>
          </li>
        )
      }
      <li><a href={site.contacts.github} target="_blank" rel="noopener">Исходный код и релизы на GitHub</a></li>
      <li><a href="https://modrinth.com" target="_blank" rel="noopener">Modrinth</a></li>
      <li><a href={`${base}privacy/`}>Политика конфиденциальности</a></li>
      <li><a href={`${base}code-signing/`}>Code signing policy</a></li>
    </ul>
    <div class="foot-contacts" aria-labelledby="contacts-title">
      <h2 id="contacts-title">Поддержка лаунчера</h2>
      <p class="contact-intro">Вопросы, ошибки и предложения — через Telegram-бота поддержки.</p>
      <ul>
        <li><a class="contact-identity" href={`https://t.me/${site.contacts.telegram}`} target="_blank" rel="noopener"><span class="contact-icon"><Icon name="telegram" /></span><span>Поддержка в Telegram</span></a></li>
      </ul>
    </div>
    <details class="footer-disclosure"><summary>Поддержать проект</summary><section class="foot-support" id="support" aria-labelledby="support-title">
      <div>
        <h2 id="support-title">Поддержать проект</h2>
        <p>Лаунчер остаётся бесплатным. Добровольная поддержка помогает оплачивать хостинг и развивать проект. Перевод не даёт платных преимуществ.</p>
      </div>
      <div class="support-action">
        <a class="btn btn-soft" href={site.support.url} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">Поддержать через ЮMoney</a>
        <p>Откроется страница сбора ЮMoney. Сумму выбираешь ты.</p>
      </div>
    </section></details>
    <p class="foot-small">
      {year && <>Femboy Launcher, {year}. </>}Шрифты Comfortaa, Nunito и Fredoka — по <a href={`${base}fonts/LICENSE-fonts.txt`}>лицензии SIL Open Font License 1.1</a>.
    </p>
  </div>
</footer>
