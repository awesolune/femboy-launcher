---
import { Image } from 'astro:assets';
import sakura from '../assets/screenshots/03-instances-sakura.png';
import midnight from '../assets/screenshots/04-instances-midnight.png';
import Icon from './Icon.astro';
import { catSvg } from '../lib/cat.js';
import { sceneSvg } from '../lib/scenes.js';

interface Props {
  version: string | null;
}
const { version } = Astro.props;
const sizes = '(max-width: 900px) calc(100vw - 32px), 720px';
// Лепестки: немного, только CSS, не ловят нажатия; при «меньше движения» не показываются
const petals = Array.from({ length: 9 }, (_, i) => ({
  x: `${(i * 11.3 + 4) % 100}%`,
  s: `${10 + ((i * 7) % 9)}px`,
  d: `${14 + ((i * 5) % 9)}s`,
  delay: `-${(i * 3.7) % 16}s`,
  drift: `${i % 2 ? '' : '-'}${40 + ((i * 13) % 60)}px`,
}));
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="petals" aria-hidden="true">
    {petals.map((p) => <span class="petal" style={`--x:${p.x};--s:${p.s};--d:${p.d};--delay:${p.delay};--drift:${p.drift}`} />)}
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow"><span class="eyebrow-line" aria-hidden="true"></span>Minecraft Java Edition · Windows</p>
      <h1 id="hero-title">
        <span class="wordmark" translate="no">Femboy Launcher</span>
        <span class="tagline">Твой Minecraft.<br /><em>Немного уютнее.</em></span>
      </h1>
      <p class="hero-lead">
        Моды, сборки и миры — в одном месте. Выбирай, во что играть, а Java и загрузчики лаунчер скачает сам.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary btn-lg" href="#download"><Icon name="download" />Скачать для Windows<Icon name="next" /></a>
        <a class="hero-secondary" href="#gallery">Посмотреть интерфейс<Icon name="next" /></a>
      </div>
      <ul class="hero-meta" aria-label="Коротко">
        <li><Icon name="check" />Бесплатно</li>
        <li><Icon name="check" />Windows 10 и 11</li>
        <li><Icon name="check" />Русский и английский</li>
      </ul>
      <a class="hero-version" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}releases/`}>{version ? `Что нового в ${version}` : 'История версий'}<Icon name="next" /></a>
    </div>

    <div class="hero-shot">
      <div class="peek" set:html={catSvg()} />
      <div class="frame">
        <Image
          class="theme-img-sakura"
          src={sakura}
          widths={[480, 760, 1100, 1400]}
          sizes={sizes}
          alt="Главный экран Femboy Launcher в теме «Сакура»: сборка «Уютное выживание», кнопка «Играть» и список сборок"
          loading="eager"
          fetchpriority="high"
        />
        <Image
          class="theme-img-midnight"
          src={midnight}
          widths={[480, 760, 1100, 1400]}
          sizes={sizes}
          alt="Главный экран Femboy Launcher в теме «Полночь»: сборка «Уютное выживание», кнопка «Играть» и список сборок"
          loading="lazy"
        />
      </div>
      <div class="paws" aria-hidden="true">
        <svg viewBox="0 0 40 30"><path d="M4 28 C2 12 10 3 20 3 C30 3 38 12 36 28" fill="#fff" stroke="#231a29" stroke-width="3" stroke-linecap="round"/><path d="M16 16 v8 M24 16 v8" stroke="#231a29" stroke-width="2.6" stroke-linecap="round"/></svg>
        <svg viewBox="0 0 40 30"><path d="M4 28 C2 12 10 3 20 3 C30 3 38 12 36 28" fill="#fff" stroke="#231a29" stroke-width="3" stroke-linecap="round"/><path d="M16 16 v8 M24 16 v8" stroke="#231a29" stroke-width="2.6" stroke-linecap="round"/></svg>
      </div>
      <div class="hero-caption">
        <span>Главный экран лаунчера</span>
        <div class="hero-themes" role="group" aria-label="Тема сайта">
          <button type="button" data-set-theme="sakura" aria-pressed="false"><Icon name="sun" />Сакура</button>
          <button type="button" data-set-theme="midnight" aria-pressed="false"><Icon name="moon" />Полночь</button>
        </div>
      </div>
    </div>
  </div>
  <div class="hero-land" aria-hidden="true">
    <div class="scene scene-sakura" set:html={sceneSvg('sakura', { id: 'hs', width: 1800, sun: false })} />
    <div class="scene scene-midnight" set:html={sceneSvg('midnight', { id: 'hm', width: 1800, sun: false })} />
  </div>
</section>
