---
import Page from '../components/PolicyPage.astro';
import {privacy,links,services} from '../data/privacy.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const english = Astro.url.pathname.startsWith(base + 'en/');
---
<Page content={english ? privacy.en : privacy.ru} links={links} services={services} />
